          }
        }
      }
    },
    "Settings → Children & pets → “Add a child or pet”. They get their own calendar with the same colors and approval rules; switch between calendars with the chips at the top." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes → Hijos y mascotas → «Añadir un hijo o una mascota». Tendrá su propio calendario con los mismos colores y reglas de aprobación; cambia entre calendarios con los chips de arriba."
          }
        }
      }
    },
    "Shared only with %@, so their “Notify on WhatsApp” buttons open your chat directly. Include the country code. Leave empty to share nothing — the buttons then open WhatsApp's contact picker instead." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se comparte con %@, para que sus botones de «Avisar por WhatsApp» abran directamente tu chat. Incluye el prefijo del país. Déjalo vacío para no compartir nada: los botones abrirán entonces el selector de contactos de WhatsApp."
          }
        }
      }
    },
    "Show invitation" : {
      "extractionState" : "manual",

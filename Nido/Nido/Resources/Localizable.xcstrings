    },
    "What does the small clock on a day mean?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué significa el relojito en un día?"
          }
        }
      }
    },
    "When either of you proposes a schedule change, it will show up here for the other to approve." : {

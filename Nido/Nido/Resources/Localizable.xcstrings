      }
    },
    "Unassigned" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin asignar"
          }
        }
      }
    },
    "Unassigned days can be filled in by either parent." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días sin asignar puede rellenarlos cualquiera de los dos."
          }
        }
      }
    },
    "Understood on this device by Apple Intelligence — nothing leaves your iPhone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entendido en este dispositivo por Apple Intelligence; nada sale de tu iPhone."
          }
        }
      }
    },
    "Until" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta"
          }
        }
      }
    },
    "Until your co-parent joins, the schedule is filled in right away and you can adjust it freely." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta que el otro progenitor se una, el plan se rellena al momento y puedes ajustarlo libremente."
          }
        }
      }
    },
    "Until your co-parent joins, you can adjust days freely." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta que el otro progenitor se una, puedes ajustar los días libremente."
          }

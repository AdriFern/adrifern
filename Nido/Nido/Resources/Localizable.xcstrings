        }
      }
    },
    "The app says “iCloud needed”." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app dice «Se necesita iCloud»."
          }
        }
      }
    },
    "The calendar" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El calendario"
          }
        }
      }
    },
    "The calendar you share with %@ was deleted or your access was removed." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El calendario que compartes con %@ se eliminó o se retiró tu acceso."
          }
        }
      }
    },
    "The days go to %@ as one proposal — nothing changes until they approve it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días se envían a %@ como una única propuesta; nada cambia hasta que la apruebe."
          }
        }
      }
    },
    "The invitation link could not be created. Please try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo crear el enlace de invitación. Inténtalo de nuevo."
          }
        }
      }
    },
    "The invitation link doesn't work on their phone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace de invitación no funciona en su teléfono."
          }
        }
      }
    },
    "The schedule is sent to %@ as one proposal — nothing changes until they approve it. Days in pending requests are left untouched." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan se envía a %@ como una única propuesta; nada cambia hasta que lo apruebe. Los días con solicitudes pendientes no se tocan."
          }
        }
      }
    },
    "The schedule was sent to %@ as one proposal covering %lld days. It will apply once they approve it." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The schedule was sent to %@ as one proposal covering 1 day. It will apply once they approve it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The schedule was sent to %@ as one proposal covering %lld days. It will apply once they approve it."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "El plan se envió a %1$@ como una única propuesta que abarca 1 día. Se aplicará cuando lo apruebe."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "El plan se envió a %1$@ como una única propuesta que abarca %2$lld días. Se aplicará cuando lo apruebe."
                }
              }
            }
          }
        }
      }
    },
    "The shared custody calendar that keeps both parents on the same page." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El calendario de custodia compartida que mantiene a ambos progenitores en sintonía."
          }
        }
      }
    },
    "They get their own custody calendar with the same colors and approval rules." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendrá su propio calendario de custodia con los mismos colores y reglas de aprobación."
          }
        }
      }
    },
    "They lose access immediately and the old invitation link stops working. The calendar and its history stay, and you can adjust all days freely until someone joins again." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perderá el acceso de inmediato y el enlace de invitación antiguo dejará de funcionar. El calendario y su historial se conservan, y podrás ajustar todos los días libremente hasta que alguien se una de nuevo."
          }
        }
      }
    },
    "They scan the code or tap the link you send." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código o toca el enlace que le envíes."
          }
        }
      }
    },
    "They scan this code with their iPhone camera, or you can send them the link." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede escanear este código con la cámara de su iPhone, o envíale el enlace."
          }
        }
      }
    },
    "This deletes their whole calendar, notes and pending requests for both parents. It can't be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todo su calendario, sus notas y sus solicitudes pendientes para ambos progenitores. No se puede deshacer."
          }
        }
      }
    },
    "This is part of a proposal covering %lld days — you approve or decline them together." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto forma parte de una propuesta que abarca %lld días; se aprueban o rechazan en conjunto."
          }
        }
      }
    },
    "This month" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mes"
          }
        }
      }
    },
    "This permanently deletes the calendar, requests and notes for both parents." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente el calendario, las solicitudes y las notas para ambos progenitores."
          }
        }
      }
    },
    "This request concerns a child or pet that was removed, so it can't be applied." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitud se refiere a un hijo o una mascota que se eliminó, así que no se puede aplicar."
          }
        }
      }
    },
    "This request was already resolved on the other side, so nothing was changed." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitud ya se había resuelto en el otro lado, así que no se cambió nada."
          }
        }
      }
    },
    "This will update %lld days." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {

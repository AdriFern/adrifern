      }
    },
    "Sign into iCloud in the iPhone's Settings app, then reopen Nido. Each parent needs their own iCloud account." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en iCloud en la app Ajustes del iPhone y vuelve a abrir Nido. Cada progenitor necesita su propia cuenta de iCloud."
          }

        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué puede ver una familia de la otra?"
          }
        }
      }
    },
    "What do you need?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué necesitas?"
          }

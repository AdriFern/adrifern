    "Who?" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Quién?" } } } },
    "Name (e.g. Emma, Rocky)" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Nombre (p. ej. Emma, Rocky)" } } } },
    "When are they with you?" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Cuándo están contigo?" } } } },
    "Pattern" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Patrón" } } } },
    "Weeks with you: %lld" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Semanas contigo: %lld" } } } },
    "Weeks away: %lld" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Semanas fuera: %lld" } } } },
    "Weeks switch on" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Las semanas cambian en" } } } },
    "Any day of a week they're with you" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Cualquier día de una semana que estén contigo" } } } },
    "Pick the handoff day (many custody schedules switch on a Friday or Monday) and any date inside a week they are — or will be — with you. The rotation is calculated from that week, forever." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige el día de cambio (muchas custodias cambian en viernes o lunes) y cualquier fecha de una semana en la que estén contigo, ahora o en el futuro. La rotación se calcula desde esa semana, para siempre." } } } },
    "Upcoming weeks" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Próximas semanas" } } } },
    "With you" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Contigo" } } } },
    "Away" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Fuera" } } } },
    "New Person or Pet" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Nueva persona o mascota" } } } },
    "Edit" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Editar" } } } },
    "e.g. Remind me to take my pill every morning at 8" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "p. ej. Recuérdame tomar mi pastilla cada mañana a las 8" } } } },
    "Describe your reminder" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Describe tu recordatorio" } } } },
    "Understood entirely on your phone — nothing is sent anywhere." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Se entiende completamente en tu teléfono: no se envía nada a ningún sitio." } } } },
    "Try one of these" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Prueba uno de estos" } } } },
    "Preview" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Vista previa" } } } },
    "Title" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Título" } } } },
    "Repeats" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Se repite" } } } },
    "Only when with you" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo cuando está contigo" } } } },
    "Not quite right? Refine opens the full editor with everything pre-filled." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¿No es exacto? Ajustar abre el editor completo con todo precargado." } } } },
    "Refine in editor…" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Ajustar en el editor…" } } } },
    "Quick Add" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Añadir rápido" } } } },
    "Only on days %@ is with you" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo los días que %@ está contigo" } } } },
    "Assumed %@ — edit if you meant the morning" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Se asumió %@; edítalo si era por la mañana" } } } },
    "That time already passed today, so it's set for tomorrow" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Esa hora ya pasó hoy, así que se programó para mañana" } } } },
    "Calendar" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Calendario" } } } },
    "Previous month" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Mes anterior" } } } },
    "Next month" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Mes siguiente" } } } },
    "%lld routine(s)" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "%lld rutina(s)" } } } },
    "%@ with you" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "%@ contigo" } } } },
    "Background tint = who's with you that day" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "El color de fondo indica quién está contigo ese día" } } } },
    "Routines" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Rutinas" } } } },
    "No routines yet" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Aún no hay rutinas" } } } },
    "Set one up step by step, or just describe it in your own words." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Créala paso a paso o simplemente descríbela con tus palabras." } } } },
    "%lld checklist steps" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "%lld pasos de lista" } } } },
    "Enabled" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Activada" } } } },
    "Settings" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Ajustes" } } } },
    "Notifications" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Notificaciones" } } } },
    "Permission" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Permiso" } } } },
    "Enable notifications" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Activar notificaciones" } } } },
    "Open iOS Settings to allow notifications" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre Ajustes de iOS para permitir notificaciones" } } } },
    "Snooze length" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Duración de posponer" } } } },
    "%lld min" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "%lld min" } } } },
    "Alarm re-alerts every" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La alarma vuelve a avisar cada" } } } },
    "Alarm re-alert count" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Número de reavisos de alarma" } } } },
    "Any-time tasks remind at" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tareas sin hora avisan a las" } } } },
    "Private notifications" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Notificaciones privadas" } } } },
    "Reminders" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Recordatorios" } } } },
    "Private notifications hide routine names and checklist items from the lock screen — banners just say a routine needs you. Changes apply to newly scheduled reminders." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Las notificaciones privadas ocultan nombres y pasos en la pantalla de bloqueo: los avisos solo dicen que una rutina te necesita. Los cambios se aplican a los próximos avisos programados." } } } },
    "Appearance & Rewards" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Apariencia y Recompensas" } } } },
    "Appearance" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Apariencia" } } } },
    "Rewards" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Recompensas" } } } },
    "%lld points" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "%lld puntos" } } } },
    "Export backup" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Exportar copia" } } } },
    "Import backup" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Importar copia" } } } },
    "Backup" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Copia de seguridad" } } } },
    "Your routines, people & pets, and history as a single file you control. Importing merges — it never deletes anything." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus rutinas, personas y mascotas e historial en un solo archivo que tú controlas. Importar combina: nunca borra nada." } } } },
    "Backup exported." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Copia exportada." } } } },
    "Backup imported." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Copia importada." } } } },
    "Export failed. Please try again." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La exportación falló. Inténtalo de nuevo." } } } },
    "Couldn't read that backup file." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo leer ese archivo de copia." } } } },
    "Alarm-mode reminders are time-sensitive alerts that can break through Focus (when Time Sensitive notifications are allowed) and re-alert until marked done, per your settings above. They follow the ring/silent switch." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Los recordatorios en modo alarma son alertas urgentes que pueden atravesar los modos de concentración (si las notificaciones urgentes están permitidas) y vuelven a avisar hasta marcarlos como hechos, según tus ajustes. Respetan el interruptor de silencio." } } } },
    "The app itself makes no network connections — no accounts, no analytics, nothing uploaded. Your data stays on this device, leaving it only through your own iCloud/device backups and exports." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La app no realiza ninguna conexión de red: sin cuentas, sin analíticas, sin subir nada. Tus datos permanecen en este dispositivo y solo salen de él a través de tus propias copias de iCloud/dispositivo y exportaciones." } } } },
    "RoutineReminder is a general-purpose reminder tool, not a medical device. iOS may delay or suppress notifications — please don't rely on it as your only reminder for critical medication." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "RoutineReminder es una herramienta de recordatorios de uso general, no un dispositivo médico. iOS puede retrasar o suprimir notificaciones: no dependas de ella como único recordatorio de medicación crítica." } } } },
    "About" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Acerca de" } } } },
    "Allowed" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Permitido" } } } },
    "Denied" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Denegado" } } } },
    "Not asked yet" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Aún no solicitado" } } } },
    "Unknown" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Desconocido" } } } },
    "A quiet day. %@ approves." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Un día tranquilo. %@ lo aprueba." } } } },
    "Almost there — keep going!" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¡Casi está! ¡Sigue así!" } } } },
    "%@, your companion" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "%@, tu compañero" } } } },
    "%lld of %lld routines done today" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "%lld de %lld rutinas hechas hoy" } } } },
    "%lld points until %@ %@" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "%lld puntos para %@ %@" } } } },
    "Real pet at home?" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Mascota de verdad en casa?" } } } },
    "Create feeding or medicine routines — they ride the same reminders and checklist as everything else." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Crea rutinas de comida o medicinas: usan los mismos avisos y listas que todo lo demás." } } } },
    "Set up a pet care routine" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Configurar una rutina de cuidado" } } } },
    "Pet Corner" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Rincón de la mascota" } } } },
    "Feed the pet" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Dar de comer a la mascota" } } } },
    "%lld points — earn %lld for every completed routine" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "%lld puntos: gana %lld por cada rutina completada" } } } },
    "Companions" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Compañeros" } } } },
    "Themes" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Temas" } } } },
    "Unlocks at %lld points" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Se desbloquea con %lld puntos" } } } },
    "Skip" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Omitir" } } } },
    "Step %lld of %lld" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Paso %lld de %lld" } } } },
    "Hi! I'm %@ 🎈" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¡Hola! Soy %@ 🎈" } } } },
    "Life's a juggle — pills, homework, pet days, rent. Let's catch things before they drop." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La vida es un malabarismo: pastillas, deberes, días de mascota, alquiler. Atrapemos las cosas antes de que se caigan." } } } },
    "Three little things" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tres cositas" } } } },
    "Just type it" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo escríbelo" } } } },
    "\"Pills every day at 8\" — understood right on your phone." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "«Pastillas cada día a las 8»: se entiende directamente en tu teléfono." } } } },
    "It knows whose week it is" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Sabe de quién es la semana" } } } },
    "Kids on alternating weeks? A pet with every-other-day meds? Reminders fire only on the right days." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Peques en semanas alternas? ¿Mascota con medicinas en días alternos? Los avisos solo llegan los días correctos." } } } },
    "Check it off, feel great" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Márcalo y siéntete genial" } } } },
    "Checklists, gentle nags until it's done, and a happy %@ when you finish." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Listas, avisos insistentes hasta terminar y un %@ feliz cuando acabas." } } } },
    "Who's in your world?" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Quién hay en tu mundo?" } } } },
    "Pick any that fit — I'll set them up so you can add their week patterns later. Totally optional!" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige los que encajen: los dejaré listos para que añadas sus patrones de semanas después. ¡Totalmente opcional!" } } } },
    "A kid part-time" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Peques a tiempo parcial" } } } },
    "A shared pet" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Una mascota compartida" } } } },
    "Daily meds" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Medicinas diarias" } } } },
    "Just me" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo yo" } } } },
    "One last thing" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Una última cosa" } } } },
    "To tap you on the shoulder at the right moment — \"pills, 8:00!\" — I need permission to send notifications. That's the whole job!" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Para darte un toque en el momento justo —«¡pastillas, 8:00!»— necesito permiso para enviar notificaciones. ¡Ese es todo el trabajo!" } } } },
    "Turn on reminders" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Activar recordatorios" } } } },
    "Continue" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Continuar" } } } },
    "My kid" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Mi peque" } } } },
    "My pet" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Mi mascota" } } } },
    "Take my meds" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Tomar mis medicinas" } } } },
    "Red" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Rojo" } } } },
    "Orange" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Naranja" } } } },
    "Yellow" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Amarillo" } } } },
    "Green" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Verde" } } } },
    "Mint" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Menta" } } } },
    "Teal" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Verde azulado" } } } },
    "Cyan" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Cian" } } } },
    "Blue" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Azul" } } } },
    "Indigo" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Índigo" } } } },
    "Purple" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Morado" } } } },
    "Pink" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Rosa" } } } },
    "Brown" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Marrón" } } } },
    "Selected icon with %@ color" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Icono seleccionado con color %@" } } } },
    "Day %lld" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Día %lld" } } } },
    "Data recovered" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Datos recuperados" } } } },
    "The app's database couldn't be opened, so a fresh one was created. The previous file was preserved on disk with a .damaged extension." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo abrir la base de datos de la app, así que se creó una nueva. El archivo anterior se conservó en el disco con la extensión .damaged." } } } }
  }
}
